
* {
  box-sizing: border-box;
}

:root {
  color-scheme: dark;
  --background: #090909;
  --surface: #171717;
  --text: #ffffff;
  --muted: #999999;
  --accent: #d8d8d8;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: Arial, sans-serif;
  -webkit-tap-highlight-color: transparent;
}

button {
  color: white;
  border: 0;
  cursor: pointer;
  font: inherit;
}

.header {
  height: 65px;
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 5;
  background: rgba(9,9,9,.96);
}

.brand {
  font-size: 17px;
  font-weight: 800;
  letter-spacing: 3px;
}

.view-toggle {
  background: #222;
  border-radius: 12px;
  width: 43px;
  height: 40px;
  font-size: 23px;
}

.catalog {
  padding: 10px;
  display: grid;
  gap: 12px;
}

.grid-view {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.product-card {
  min-width: 0;
  background: var(--surface);
  border-radius: 13px;
  overflow: hidden;
  cursor: pointer;
}

.product-image {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  display: block;
  background: linear-gradient(145deg, #303030, #111);
}

.product-details {
  padding: 11px;
}

.product-name {
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 7px;
}

.product-price {
  font-size: 15px;
  font-weight: 800;
}

.carousel-view {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding: 14px 18px 25px;
  gap: 15px;
  scrollbar-width: none;
}

.carousel-view::-webkit-scrollbar {
  display: none;
}

.carousel-view .product-card {
  flex: 0 0 78%;
  scroll-snap-align: center;
}

.carousel-view .product-image {
  aspect-ratio: 3 / 4;
}

.viewer {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: #000;
  overflow: hidden;
  touch-action: pan-y;
}

.hidden {
  display: none !important;
}

#productVideo {
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #000;
}

.video-shade {
  position: absolute;
  inset: 35% 0 0;
  pointer-events: none;
  background: linear-gradient(transparent, rgba(0,0,0,.78));
}

.close-button,
.sound-button {
  position: absolute;
  top: max(18px, env(safe-area-inset-top));
  width: 43px;
  height: 43px;
  border-radius: 50%;
  background: rgba(30,30,30,.72);
  font-size: 19px;
  z-index: 2;
}

.close-button {
  left: 16px;
}

.sound-button {
  right: 16px;
}

.product-info {
  position: absolute;
  bottom: max(55px, env(safe-area-inset-bottom));
  left: 20px;
  right: 20px;
  z-index: 2;
  pointer-events: none;
}

.viewer-name {
  font-size: 21px;
  font-weight: 800;
  margin-bottom: 8px;
}

.viewer-price {
  font-size: 25px;
  font-weight: 800;
  margin-bottom: 10px;
}

.viewer-description {
  font-size: 14px;
  line-height: 1.5;
  color: #ddd;
  max-width: 450px;
}

.swipe-hint {
  position: absolute;
  bottom: 18px;
  right: 20px;
  color: #aaa;
  font-size: 9px;
  letter-spacing: 1.5px;
}

@media (min-width: 700px) {
  .catalog {
    max-width: 850px;
    margin: auto;
  }

  .grid-view {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .carousel-view .product-card {
    flex-basis: 280px;
  }
}
